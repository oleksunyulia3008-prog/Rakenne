{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "fileLocation": "relative",
        "pattern": { "regexp": "^.*" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*VITE.*",
          "endsPattern": ".*Local:.*http://localhost:5173/.*"
        }
      },
      "label": "npm: dev",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}